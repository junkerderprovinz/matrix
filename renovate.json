{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>junkerderprovinz/junkerderprovinz//renovate/base",
    "local>junkerderprovinz/junkerderprovinz//renovate/components"
  ],
  "packageRules": [
    {
      "description": "Synapse upstream: major bumps are breaking, keep manual",
      "matchPackageNames": [
        "ghcr.io/element-hq/synapse"
      ],
      "groupName": "Synapse",
      "commitMessageTopic": "Synapse",
      "commitMessagePrefix": "feat:",
      "labels": [
        "upstream-bump",
        "synapse"
      ]
    },
    {
      "description": "Element Web upstream",
      "matchPackageNames": [
        "vectorim/element-web"
      ],
      "groupName": "Element Web",
      "commitMessageTopic": "Element Web",
      "commitMessagePrefix": "feat:",
      "labels": [
        "upstream-bump",
        "element"
      ]
    },
    {
      "description": "Ketesa (admin UI, formerly Synapse-Admin) upstream",
      "matchPackageNames": [
        "ghcr.io/etkecc/ketesa"
      ],
      "groupName": "Ketesa",
      "commitMessageTopic": "Ketesa",
      "commitMessagePrefix": "feat:",
      "labels": [
        "upstream-bump",
        "synapse-admin"
      ]
    },
    {
      "description": "Matrix Authentication Service: auth is load-bearing, keep manual",
      "matchPackageNames": [
        "ghcr.io/element-hq/matrix-authentication-service"
      ],
      "groupName": "MAS",
      "commitMessageTopic": "Matrix Authentication Service",
      "commitMessagePrefix": "feat:",
      "labels": [
        "upstream-bump",
        "mas"
      ],
      "automerge": false
    },
    {
      "description": "The upstream images are referenced as FROM image:${VERSION}, where Renovate can raise the tag in the ARG but has nowhere to write a digest",
      "matchPackageNames": [
        "ghcr.io/element-hq/synapse",
        "vectorim/element-web",
        "ghcr.io/etkecc/ketesa",
        "ghcr.io/element-hq/matrix-authentication-service"
      ],
      "pinDigests": false
    },
    {
      "description": "The compose file is for people to copy, so it follows the app's own latest tag instead of a digest that goes stale every build",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "junkerderprovinz/matrix"
      ],
      "enabled": false
    }
  ]
}
