#!/command/with-contenv sh
# shellcheck shell=sh
# The Synapse homeserver, run in the foreground through exec so s6 supervises it
# and receives its signals.

PUID="${PUID:-99}"
PGID="${PGID:-100}"

export SYNAPSE_SERVER_NAME="${SERVER_NAME}"
export SYNAPSE_CONFIG_PATH="/data/homeserver.yaml"

# Relative paths resolve under the volume instead of the read-only s6 service
# directory.
cd /data || { echo "[synapse] FATAL: cannot cd into /data" >&2; exit 1; }

# --config-path is repeatable and the later file wins, which is how the overrides
# take effect; Synapse ignores include directives in homeserver.yaml. Without the
# second path it falls back to SQLite and every override is dead config (#3).
exec gosu "${PUID}:${PGID}" \
    python -m synapse.app.homeserver \
        --config-path /data/homeserver.yaml \
        --config-path /data/homeserver-overrides.yaml \
        --keys-directory /data
