#!/command/with-contenv sh
# shellcheck shell=sh
# Prints "MATRIX IS READY" to the log once Synapse answers /health, so the user
# knows the first start (30-60s) has finished.
FLAG=/run/matrix-ready.printed

# /run is a tmpfs, so the banner prints once per container start.
if [ -f "$FLAG" ]; then
    exec sleep infinity
fi

# Same check as HEALTHCHECK, for at most five minutes.
ready=0
i=0
while [ "$i" -lt 150 ]; do
    if curl -fsS http://127.0.0.1:8008/health >/dev/null 2>&1; then
        ready=1
        break
    fi
    i=$((i + 1))
    sleep 2
done

# With delegated auth, logins fail while MAS is still migrating its database, so
# ready includes its internal health listener. The wait is capped at a minute so
# a missing MAS is reported instead of hidden behind a hang.
mas_ready=""
case "$(printf '%s' "${AUTH_ENABLED:-false}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on)
        mas_ready=0
        j=0
        while [ "$j" -lt 30 ]; do
            if curl -fsS http://127.0.0.1:8091/health >/dev/null 2>&1; then
                mas_ready=1
                break
            fi
            j=$((j + 1))
            sleep 2
        done
        ;;
esac

/usr/local/bin/print-banner.sh "Matrix" "Synapse + Element + coturn, plug-and-play for Unraid"

# Plain ANSI codes, since tput needs a terminfo database the image may lack.
# printf '%b' because echo -e is not POSIX.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ "$ready" -eq 1 ]; then
    printf '%b\n' "  ${GREEN}✓ MATRIX IS READY${NC} - Synapse is serving on port 8008 (point your reverse proxy / Element here)"
    if [ "$mas_ready" = "1" ]; then
        printf '%b\n' "  ${GREEN}✓ AUTH IS READY${NC} - Matrix Authentication Service is serving on port 8090 (QR code login available)"
    elif [ "$mas_ready" = "0" ]; then
        printf '%b\n' "  ${YELLOW}! AUTH DID NOT BECOME READY${NC} - MAS /health never answered, logins will fail, check the log above"
    fi
else
    printf '%b\n' "  ${RED}✗ MATRIX DID NOT BECOME READY${NC} - Synapse /health never answered within 5 min, check the log above"
fi
echo ""

: > "$FLAG"
# Stay up so s6 does not restart the service and print the banner again.
exec sleep infinity
