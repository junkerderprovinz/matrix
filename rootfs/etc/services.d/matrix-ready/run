#!/command/with-contenv sh
# shellcheck shell=sh
# =============================================================================
# matrix-ready — print a loud "MATRIX IS READY" banner to the container log once
# Synapse answers on its health endpoint, so the user knows the (30-60s) first
# start has finished. House standard, see the vault note "Style Guide - Docker
# Container" (every own-image container prints an "<APP> IS READY" log banner).
# =============================================================================
FLAG=/run/matrix-ready.printed

# /run is tmpfs (wiped on every container start) -> the banner prints once/start.
if [ -f "$FLAG" ]; then
    exec sleep infinity
fi

# Wait until Synapse answers on its health endpoint (same check as HEALTHCHECK).
# Capped at ~5 min so we never hang forever.
ready=0
i=0
while [ "$i" -lt 150 ]; do
    if curl -fsS http://127.0.0.1:8008/health >/dev/null 2>&1; then
        ready=1
        break
    fi
    i=$((i + 1))
    sleep 2
done

# When delegated auth is on, MAS is part of "ready": Synapse answering /health
# while MAS is still migrating its database means logins fail for anyone who
# tries in that window. Gate on its internal health listener too, but never let
# it block the banner for longer than a minute — a missing MAS is reported, not
# hidden behind a silent hang.
mas_ready=""
case "$(printf '%s' "${AUTH_ENABLED:-false}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on)
        mas_ready=0
        j=0
        while [ "$j" -lt 30 ]; do
            if curl -fsS http://127.0.0.1:8091/health >/dev/null 2>&1; then
                mas_ready=1
                break
            fi
            j=$((j + 1))
            sleep 2
        done
        ;;
esac

# House init-log banner as the final block, directly above the READY box.
/usr/local/bin/print-banner.sh "Matrix" "Synapse + Element + coturn, plug-and-play for Unraid"

# Colored via plain ANSI SGR codes, not tput (tput needs a terminfo database
# that may not exist in a minimal container): 32 green / 33 yellow / 31 red,
# 0 reset. docker logs passes stdout bytes through untouched, so any
# ANSI-aware viewer (a real terminal, Unraid's log panel) renders the color;
# a viewer that does not understand SGR codes just shows them as inert text.
# printf '%b', not "echo -e": this script is POSIX sh, where -e is not
# portable.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

# Clean one-line-per-service status (house look: no rule/box walls, label +
# detail on the same line). print-banner.sh already left one blank line
# above this. Synapse and MAS are two separate services, so up to two status
# lines can appear -- each still fully combined to one line.
if [ "$ready" -eq 1 ]; then
    printf '%b\n' "  ${GREEN}✓ MATRIX IS READY${NC} - Synapse is serving on port 8008 (point your reverse proxy / Element here)"
    if [ "$mas_ready" = "1" ]; then
        printf '%b\n' "  ${GREEN}✓ AUTH IS READY${NC} - Matrix Authentication Service is serving on port 8090 (QR code login available)"
    elif [ "$mas_ready" = "0" ]; then
        printf '%b\n' "  ${YELLOW}! AUTH DID NOT BECOME READY${NC} - MAS /health never answered, logins will fail, check the log above"
    fi
else
    printf '%b\n' "  ${RED}✗ MATRIX DID NOT BECOME READY${NC} - Synapse /health never answered within 5 min, check the log above"
fi
echo ""

: > "$FLAG"
# Longrun: stay up so s6 does not restart us and re-print the banner.
exec sleep infinity
