#!/command/with-contenv sh
# shellcheck shell=sh
# Matrix Authentication Service. Without AUTH_ENABLED=true the service idles on
# `sleep infinity` like matrix-ready, because a script that exits is restarted by
# s6 forever.
#
# No start order is needed: Synapse validates its MAS settings locally
# (synapse/config/mas.py never calls MAS) and MAS runs its own migrations. Only
# the config from 20-mas.sh has to exist.

PUID="${PUID:-99}"
PGID="${PGID:-100}"

case "$(printf '%s' "${AUTH_ENABLED:-false}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on) : ;;
    *) exec sleep infinity ;;
esac

CONFIG=/data/mas/config.yaml

# 20-mas.sh writes the config before any service starts, so the wait only
# catches that script having bailed out.
i=0
while [ ! -s "${CONFIG}" ]; do
    i=$((i + 1))
    if [ "${i}" -gt 30 ]; then
        echo "[mas] FATAL: ${CONFIG} was never written; check the [mas] lines earlier in this log." >&2
        exit 1
    fi
    sleep 1
done

echo "[mas] Starting Matrix Authentication Service on port 8090 ..."
exec gosu "${PUID}:${PGID}" /usr/local/bin/mas-cli server --config "${CONFIG}"
