#!/command/with-contenv sh
# shellcheck shell=sh
# Serves Element Web and Ketesa as static files on port 8080.

# A missing document root gives a clearer error here than inside lighttpd.
if [ ! -d /var/www/html/element ]; then
    printf '[lighttpd] ERROR: /var/www/html/element does not exist.\n' >&2
    exit 1
fi

if [ ! -d /var/www/html/admin ]; then
    printf '[lighttpd] ERROR: /var/www/html/admin does not exist.\n' >&2
    exit 1
fi

# -D keeps lighttpd in the foreground for s6.
exec /usr/sbin/lighttpd -D -f /defaults/lighttpd.conf
