#!/command/with-contenv sh
# shellcheck shell=sh
# coturn, configured by /data/turnserver.conf, which 10-config.sh renders.

# In case s6 starts the service before cont-init.d has finished.
TURN_CONF="/data/turnserver.conf"
RETRIES=30
i=0
while [ ! -f "${TURN_CONF}" ]; do
    if [ "${i}" -ge "${RETRIES}" ]; then
        printf '[coturn] ERROR: %s not found after %d seconds, giving up.\n' "${TURN_CONF}" "${RETRIES}" >&2
        exit 1
    fi
    printf '[coturn] Waiting for %s ...\n' "${TURN_CONF}"
    sleep 1
    i=$((i + 1))
done

# coturn starts as root and drops to nobody itself (proc-user in turnserver.conf).
# Dropping earlier with gosu fails with "opening errorlog /dev/stderr failed:
# Permission denied", because coturn then cannot open the inherited descriptors.
exec /usr/bin/turnserver \
    -c "${TURN_CONF}" \
    --no-cli \
    --simple-log
