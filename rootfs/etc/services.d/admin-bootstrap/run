#!/command/with-contenv sh
# shellcheck shell=sh
# One-shot service that creates the admin account from /data/.create_admin, which
# 10-config.sh writes when ADMIN_USER and ADMIN_PASSWORD are set. It waits for
# Synapse, registers the user with register_new_matrix_user, marks
# /data/.admin_created and removes the credential file. Afterwards it sleeps, so
# s6 does not restart it.

set -u

# register_new_matrix_user validates homeserver.yaml, which resolves relative
# paths against the working directory, and the s6 service directory is read-only.
cd /data || { echo "[admin-bootstrap] FATAL: cannot cd into /data" >&2; exec sleep infinity; }

CRED_FILE="/data/.create_admin"
DONE_FILE="/data/.admin_created"

log() { printf '\033[0;36m[admin-bootstrap] %s\033[0m\n' "$*"; }

if [ ! -f "$CRED_FILE" ]; then
    log "No credential file present, nothing to do."
    exec sleep infinity
fi

# Under delegated auth neither mechanism of this service works, and both would
# fail silently: Synapse does not register /_synapse/admin/v1/register, which
# register_new_matrix_user posts to, and the Postgres fallback has no effect
# because synapse/api/auth/mas.py authorises on the token scope
# urn:synapse:admin:*, not on users.admin. So the user gets the commands that do
# work. The credential file stays, so switching AUTH_ENABLED off again still
# bootstraps the admin.
case "$(printf '%s' "${AUTH_ENABLED:-false}" | tr '[:upper:]' '[:lower:]')" in
    true|1|yes|on)
        log "AUTH_ENABLED is on, so ADMIN_USER/ADMIN_PASSWORD cannot be applied through Synapse."
        log "Under delegated auth, accounts and admin rights live in MAS. Use instead:"
        log "  docker exec -it <container> mas-cli manage register-user --config /data/mas/config.yaml \\"
        log "      --yes --admin --password '<password>' <username>"
        log "  docker exec -it <container> mas-cli manage promote-admin --config /data/mas/config.yaml <username>"
        log "For an admin token that the admin UI accepts:"
        log "  docker exec -it <container> mas-cli manage issue-compatibility-token \\"
        log "      --config /data/mas/config.yaml <username> --yes-i-want-to-grant-synapse-admin-privileges"
        exec sleep infinity
        ;;
esac

log "Waiting for Synapse to become ready on http://127.0.0.1:8008/health ..."
i=0
while [ $i -lt 60 ]; do
    if curl -fsS --max-time 2 -o /dev/null "http://127.0.0.1:8008/health" 2>/dev/null; then
        log "Synapse is ready."
        break
    fi
    i=$((i + 1))
    sleep 2
done

if [ $i -ge 60 ]; then
    log "WARNING: Synapse did not become ready within 120s; aborting admin creation."
    exec sleep infinity
fi

USER=$(sed -n '1p' "$CRED_FILE")
PASS=$(sed -n '2p' "$CRED_FILE")

if [ -z "$USER" ] || [ -z "$PASS" ]; then
    log "ERROR: credentials file is malformed, skipping."
    rm -f "$CRED_FILE"
    exec sleep infinity
fi

log "Registering admin user '$USER' ..."
out=$(register_new_matrix_user \
        -c /data/homeserver.yaml \
        -u "$USER" \
        -p "$PASS" \
        -a \
        http://127.0.0.1:8008 2>&1)
rc=$?
[ -n "$out" ] && printf '%s\n' "$out"

if [ $rc -eq 0 ]; then
    log "Admin user '$USER' created successfully."
    : > "$DONE_FILE"
    rm -f "$CRED_FILE"
else
    # Only an explicit "already exists" counts as done; any other failure keeps
    # the credential file so the next restart retries.
    case "$out" in
        *"already taken"*|*M_USER_IN_USE*)
            # register_new_matrix_user -a sets the server-admin flag only on a new
            # account, so a user who self-registered in Element stays a normal user
            # and the admin UI fails with "Server communication error" (403 on
            # /_synapse/admin). The flag is set in Postgres directly, the documented
            # way to grant server admin; psycopg2 and the POSTGRES_* variables are
            # already there.
            log "User '$USER' already exists, ensuring it is a Synapse server admin ..."
            if python3 - "$USER" <<'PY'
import os, sys
import psycopg2
u = sys.argv[1]
name = u if u.startswith("@") else "@%s:%s" % (u, os.environ["SERVER_NAME"])
conn = psycopg2.connect(
    host=os.environ["POSTGRES_HOST"], port=os.environ.get("POSTGRES_PORT", "5432"),
    user=os.environ["POSTGRES_USER"], password=os.environ["POSTGRES_PASSWORD"],
    dbname=os.environ["POSTGRES_DB"])
cur = conn.cursor()
cur.execute("UPDATE users SET admin=1 WHERE name=%s", (name,))
conn.commit()
print("[admin-bootstrap] admin flag set for %s (rows matched: %d)" % (name, cur.rowcount))
PY
            then
                log "Ensured '$USER' is a server admin (Synapse-Admin will work after re-login)."
                : > "$DONE_FILE"
                rm -f "$CRED_FILE"
            else
                log "WARNING: could not reach Postgres to promote '$USER'; will retry on next restart."
            fi
            ;;
        *)
            log "ERROR: register_new_matrix_user failed with exit code $rc."
            log "Leaving credential file in place; will retry on next container restart."
            ;;
    esac
fi

# Idle, so s6 sees the service running and does not restart it.
exec sleep infinity
