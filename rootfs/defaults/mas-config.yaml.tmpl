# Rendered by 20-mas.sh to /data/mas/config.yaml when AUTH_ENABLED is true;
# otherwise this file is unused and MAS never starts.
#
# Keep it a single file. MAS merges repeated --config files with figment's admerge,
# which concatenates arrays instead of replacing them: a second file with its own
# http.listeners would add a bind on [::]:8080, where lighttpd listens, and a
# matrix block with both `secret` and `secret_file` is rejected with "Cannot
# specify both 'secret' and 'secret_file'". For the same reason every secret is
# referenced through *_file; the values live in /data/mas/ with mode 600 and
# survive container recreation.
#
# CI parses this file as YAML after substituting the placeholders, so a ${...}
# must not stand where the syntax needs a bare value.

http:
  # Has to be https://: MAS rejects plain http redirect and client URIs during the
  # dynamic client registration that Element Web's OIDC flow uses, and 20-mas.sh
  # refuses to start otherwise. `issuer` stays unset so MAS derives it from
  # public_base instead of keeping the same URL in two places.
  public_base: "${AUTH_PUBLIC_BASE}"
  listeners:
    # Public listener. 8090, not MAS's default 8080, which lighttpd already owns
    # inside this container.
    - name: web
      resources:
        - name: discovery
        - name: human
        - name: oauth
        - name: compat
        - name: graphql
        - name: assets
        - name: adminapi
      binds:
        - address: "0.0.0.0:8090"
      proxy_protocol: false
    # Loopback-only health endpoint for the mas service script and for
    # matrix-ready before it prints the READY banner.
    - name: internal
      resources:
        - name: health
      binds:
        - address: "127.0.0.1:8091"
      proxy_protocol: false

database:
  host: "${AUTH_POSTGRES_HOST}"
  port: ${AUTH_POSTGRES_PORT}
  username: "${AUTH_POSTGRES_USER}"
  password: "${AUTH_POSTGRES_PASSWORD}"
  # A database of its own, separate from Synapse's and empty on first start:
  # syn2mas refuses to run against a non-empty MAS database.
  database: "${AUTH_POSTGRES_DB}"

matrix:
  kind: synapse
  # Has to be exactly Synapse's server_name, otherwise syn2mas rejects the
  # migration and MAS cannot address the homeserver.
  homeserver: "${SERVER_NAME}"
  endpoint: "http://127.0.0.1:8008/"
  secret_file: /data/mas/matrix.secret

secrets:
  # 20-mas.sh creates these once and they must never change afterwards: a new
  # encryption secret loses every encrypted value in the MAS database, and a new
  # key or kid invalidates all issued tokens.
  encryption_file: /data/mas/encryption.secret
  keys:
    - kid: primary
      key_file: /data/mas/keys/rsa.key

passwords:
  enabled: true
  schemes:
    # Scheme 1 matches the bcrypt hashes Synapse already holds; without it every
    # account migrated by syn2mas loses its password.
    - version: 1
      algorithm: bcrypt
      unicode_normalization: true
    # New and changed passwords are written with the stronger scheme.
    - version: 2
      algorithm: argon2id

account:
  # Off by default like Synapse's enable_registration; when turning it on, add a
  # token or CAPTCHA.
  password_registration_enabled: ${AUTH_ALLOW_REGISTRATION}
  password_change_allowed: true
  email_change_allowed: true
  displayname_change_allowed: true
  account_deactivation_allowed: true

policy:
  # Ships inside the image next to the binary; the policy engine is in-process
  # WebAssembly, so there is no OPA daemon to run.
  wasm_module: /usr/local/share/mas-cli/policy.wasm

clients: []
