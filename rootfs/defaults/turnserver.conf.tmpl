# Rendered by 10-config.sh into /data/turnserver.conf.
#
#   ${SERVER_NAME}  realm, which should match the Matrix domain
#   ${TURN_SECRET}  shared secret for time-limited HMAC credentials

listening-port=3478

# Has to match the published UDP ports (Dockerfile EXPOSE and the Unraid
# template), or relayed calls fail.
min-port=49160
max-port=49200

listening-ip=0.0.0.0

# The external IP/hostname clients use to reach this server.
# In most Unraid setups this is the LAN IP of the host.
# If behind NAT with port-forwarding, set this to your public IP.
# Leave commented out to auto-detect (works in most home lab scenarios).
# external-ip=YOUR_PUBLIC_IP

# The realm is shown to clients during authentication. Conventionally set to
# the Matrix server domain.
realm=${SERVER_NAME}

# HMAC-SHA1 time-limited credentials issued by Synapse; the secret must match
# turn_shared_secret in homeserver-overrides.yaml.tmpl.
use-auth-secret
static-auth-secret=${TURN_SECRET}

# Keeps clients from using coturn as a relay into private networks (SSRF).
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
# Loopback
denied-peer-ip=127.0.0.0-127.255.255.255
# Link-local
denied-peer-ip=169.254.0.0-169.254.255.255
# Carrier-grade NAT
denied-peer-ip=100.64.0.0-100.127.255.255
# IPv6 link-local
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

# coturn logs in syslog format to stderr; the service script adds --simple-log so
# the log reaches the inherited stdout.
syslog

# coturn starts as root, so it can open the supervisor's stdout and stderr and
# bind any port, and then drops to nobody itself. Dropping earlier with gosu
# breaks its access to /dev/stderr.
proc-user=nobody
proc-group=nogroup

# Fingerprint STUN responses for better client compatibility
fingerprint

# 0 leaves bandwidth, total and per-user relay quotas unlimited.
max-bps=0
total-quota=0
user-quota=0

# Filled in by 10-config.sh: the TLS listener when /data/certs holds fullchain.pem
# and privkey.pem, otherwise no-tls and no-dtls. coturn calls the directives cert
# and pkey, not tls-cert and tls-pkey.
${TURN_TLS_CONF}
