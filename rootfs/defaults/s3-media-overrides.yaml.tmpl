# S3 media storage provider. Rendered by 15-s3-media.sh and appended to
# /data/homeserver-overrides.yaml when S3_MEDIA_ENABLED=true; with the switch off
# nothing of it is emitted, the same opt-in contract as MAS.
#
# store_local keeps every upload in /data/media_store as a hot cache (Synapse looks
# there before asking a provider), and store_remote with store_synchronous copies
# each new upload to the bucket before the upload call returns. Existing local
# media is not migrated; the README section "S3 Media Storage" covers the one-off
# migrate_media_to_s3.py script.
#
# endpoint_url has no default because the feature targets self-hosted
# S3-compatible stores (SeaweedFS, Garage, MinIO), so 15-s3-media.sh fails when it
# is unset rather than quietly talking to AWS.

media_storage_providers:
  - module: s3_storage_provider.S3StorageProviderBackend
    store_local: True
    store_remote: True
    store_synchronous: True
    config:
      bucket: "${S3_MEDIA_BUCKET}"
      region_name: "${S3_MEDIA_REGION}"
      endpoint_url: "${S3_MEDIA_ENDPOINT}"
      access_key_id: "${S3_MEDIA_ACCESS_KEY_ID}"
      secret_access_key: "${S3_MEDIA_SECRET_ACCESS_KEY}"
      storage_class: "${S3_MEDIA_STORAGE_CLASS}"
