# Synapse side of delegated auth. Rendered by 20-mas.sh and appended to
# /data/homeserver-overrides.yaml when AUTH_ENABLED=true. With the switch off
# nothing of it is emitted, not even `matrix_authentication_service: {enabled:
# false}`, so a homeserver that pulls a newer image keeps exactly its old config.
#
# Two Synapse constraints apply:
#
#   1. `enable_registration: true` with delegated auth is a ConfigError
#      ("Registration cannot be enabled when OAuth delegation is enabled") that
#      stops Synapse, so 20-mas.sh strips the enable_registration lines from the
#      rendered overrides before appending this block.
#   2. `experimental_features` may appear only once in the merged YAML, so
#      20-mas.sh removes the base template's `experimental_features: {}`.
#
# password_config.enabled and enable_3pid_changes stay unset: Synapse defaults
# both to `not auth_delegated`.

matrix_authentication_service:
  enabled: true
  # MAS listens on 8090 inside this container; loopback, never over the network.
  endpoint: "http://127.0.0.1:8090/"
  secret_path: /data/mas/matrix.secret

experimental_features:
  # MSC4108, QR code login, needs delegated auth; Synapse itself is the rendezvous
  # server. msc4108_delegation_endpoint stays unset, since setting both is a
  # ConfigError, and msc4388_mode stays off: Synapse does not advertise MSC4388
  # and neither element-web nor matrix-js-sdk use it.
  msc4108_enabled: ${AUTH_QR_LOGIN}
